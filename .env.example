DATABASE_URL=sqlite:///./money.db
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8000
# App System mode for a deployed Money Tracker. Configure the values below on
# the relevant Vercel projects; never commit real key or database URL values.
NEXT_PUBLIC_AUTH_MODE=local
# INFRA_URL=https://system.minkoi.org
# INFRA_APP_ID=money-tracker-app-id-from-app-system
# INFRA_PUBLISHABLE_KEY=pk_from-app-system
# INFRA_SECRET_KEY=sk_from-app-system
# APP_URL=https://your-money-tracker-domain

# Read-only bank connections. Set ONLY on the API server; no NEXT_PUBLIC_ keys.
# Sandbox uses synthetic accounts. Real Chase/PNC require Plaid Production access.
# PLAID_ENV=sandbox
# PLAID_CLIENT_ID=from-plaid-dashboard
# PLAID_SECRET=from-plaid-dashboard
# PLAID_REDIRECT_URI=http://localhost:3000/banks/callback
# BANK_TOKEN_ENCRYPTION_KEYS=one-or-more-comma-separated-fernet-keys
# Generate a new key locally with:
# .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
